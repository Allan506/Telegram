# Token que te da @BotFather en Telegram (obligatorio)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Opcional: limita el bot a estos IDs de usuario (separados por comas).
# Deja vacío para que cualquiera pueda usarlo.
ALLOWED_USER_IDS=

# Opcional: INFO, DEBUG, WARNING...
LOG_LEVEL=INFO

# Opcional: segundos de long polling (30 es un buen valor)
POLL_TIMEOUT=30

# Opcional: apaga el proceso tras N segundos (0 = sin límite)
MAX_RUNTIME_SECONDS=0

# Opcional: guarda el offset de las actualizaciones en este fichero
STATE_FILE=state/bot-state.json

# Opcional: al arrancar, descarta los mensajes pendientes en lugar de responderlos
DRAIN_ON_START=true

# Solo para GitHub Actions: reinicia el workflow antes de salir
SELF_RESTART=false
